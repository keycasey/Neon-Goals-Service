{
  "name": "neon-goals-service",
  "version": "1.0.0",
  "description": "Neon Goals Backend API",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "./dev.sh",
    "dev:server": "bun run start:dev",
    "dev:worker": "bun run worker:dev",
    "seed": "bun run prisma:seed",
    "ai-models:export": "ts-node scripts/export-ai-models.ts",
    "prompts:generate": "bun run ai-models:export && cd prompts && uv run python -m neon_prompts.cli generate",
    "worker:dev": "cd worker && NEON_GOALS_API_URL=http://localhost:3001 .venv/bin/python -m uvicorn main:app --port 5001 --reload",
    "worker:dspy:extract": "cd worker && python -m dspy_pipeline.cli extract",
    "worker:dspy:baseline": "cd worker && python -m dspy_pipeline.cli baseline",
    "worker:dspy:optimize": "cd worker && python -m dspy_pipeline.cli optimize --dry-run",
    "worker:dspy:bundle": "cd worker && python -m dspy_pipeline.cli bundle-stub",
    "build": "bun run prompts:generate && tsc",
    "build:deploy": "tsc",
    "test": "bun test",
    "verify": "bun run prisma:generate && bun test && bun run build:deploy",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "mcp:grant": "ts-node scripts/issue-mcp-grant.ts",
    "mcp:revoke": "ts-node scripts/revoke-mcp-grant.ts",
    "plaid:clear-legacy-credentials": "ts-node scripts/clear-legacy-plaid-credentials.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "plaid": "^41.4.0",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@types/bcrypt": "6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ajv": "8.20.0",
    "body-parser": "2.3.0",
    "browserslist": "4.29.3",
    "defu": "6.1.7",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "path-to-regexp": "8.4.2",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  }
}
